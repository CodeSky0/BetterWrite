# Database (SQLite file for local development)
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Redis (optional for local dev; required for Docker/multi-instance)
REDIS_URL=redis://localhost:6379

# Next.js / Auth
NEXTAUTH_SECRET=dev-secret-do-not-use-in-production
NEXT_PUBLIC_API_URL=http://localhost:3000

# Encryption (64 hex characters = 256-bit key)
# 用于加密存储超管后台配置的 AI API 密钥，web 与 worker 必须一致
# 生成命令：openssl rand -hex 32
ENCRYPTION_KEY=

# AI Providers
# AI API 密钥不再通过环境变量配置，请登录超管后台「API 管理」页面统一配置
# （支持 OpenAI / DeepSeek / Anthropic / Qwen / 自定义 OpenAI 兼容端点）

# Push notifications (optional)
EXPO_ACCESS_TOKEN=

# Docker Compose
WEB_PORT=3000
